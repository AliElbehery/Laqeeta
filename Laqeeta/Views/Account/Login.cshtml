@model LoginVm
@{ ViewData["Title"] = L["auth.login"]; }
<div class="row justify-content-center"><div class="col-md-6 col-lg-5">
<div class="card shadow-sm"><div class="card-body p-4">
    <h1 class="h4 mb-3">@L["auth.login"]</h1>
    <partial name="_Errors" />
    <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
        <div class="mb-3">
            <label asp-for="UsernameOrEmail" class="form-label">@L["auth.usernameOrEmail"]</label>
            <input asp-for="UsernameOrEmail" class="form-control" autofocus autocomplete="username" />
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">@L["auth.password"]</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">@L["auth.remember"]</label>
        </div>
        <button class="btn btn-primary w-100">@L["auth.login"]</button>
    </form>
    <p class="text-center mt-3 mb-0">@L["auth.noAccount"] <a asp-action="Register">@L["auth.register"]</a></p>
</div></div></div></div>
