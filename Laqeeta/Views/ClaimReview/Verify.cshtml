@model VerifyPageVm
@{
    ViewData["Title"] = L["claim.verify"];
    var c = Model.Claim;
    var m = Model.Match;
}
<a asp-action="Index" class="text-decoration-none">← @L["nav.claims"]</a>
<h1 class="h3 my-3">@L["claim.verify"] #@c.ClaimId</h1>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3"><div class="card-body">
            <h2 class="h6 text-muted">@L["claim.claimant"]</h2>
            <div><strong>@c.ClaimedByUser?.FullName</strong> · @c.ClaimedByUser?.Phone</div>
            <div class="small text-muted">@L["claim.claimedAt"]: @L.Dt(c.ClaimedAt)</div>
        </div></div>
        @if (m is not null)
        {
            <div class="card shadow-sm mb-3"><div class="card-body">
                <h2 class="h6 text-muted">📝 @L["match.report"] #@m.Report.ReportId</h2>
                <div>@L.Of(m.Report.Category) — @m.Report.Color</div>
                <div class="small">@m.Report.Description</div>
                <div class="small text-muted">🚇 @m.Report.Line?.LineName · 📅 @m.Report.LostDate.ToString("yyyy-MM-dd")</div>
            </div></div>
            <div class="card shadow-sm"><div class="card-body">
                <h2 class="h6 text-muted">📦 @L["match.item"] #@m.ItemId</h2>
                <div>@L.Of(m.Item.Category) — @m.Item.Color</div>
                <div class="small">@m.Item.Description</div>
                <div class="mt-2"><span class="badge text-bg-dark">🔒 @L["items.privateDetails"]</span>
                    @(string.IsNullOrWhiteSpace(m.Item.PrivateIdentifyingDetails) ? "—" : m.Item.PrivateIdentifyingDetails)</div>
            </div></div>
        }
    </div>
    <div class="col-lg-5"><div class="card shadow-sm"><div class="card-body">
        <h2 class="h5">@L["claim.checklist"]</h2>
        <form method="post" asp-action="Verify" asp-route-id="@c.ClaimId">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="idc" name="IdChecked" value="true" @(Model.Form.IdChecked ? "checked" : "") />
                <input type="hidden" name="IdChecked" value="false" />
                <label class="form-check-label" for="idc">@L["claim.idChecked"]</label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="sap" name="SecretAnswerPassed" value="true" @(Model.Form.SecretAnswerPassed ? "checked" : "") />
                <input type="hidden" name="SecretAnswerPassed" value="false" />
                <label class="form-check-label" for="sap">@L["claim.secretPassed"]</label>
            </div>
            <div class="mb-3">
                <label class="form-label" for="notes">@L["claim.notes"]</label>
                <textarea id="notes" name="Notes" class="form-control" rows="3">@Model.Form.Notes</textarea>
            </div>
            <div class="d-flex gap-2">
                <button name="approve" value="true" class="btn btn-success">✔ @L["claim.approve"]</button>
                <button name="approve" value="false" class="btn btn-outline-danger">✖ @L["claim.reject"]</button>
            </div>
        </form>
    </div></div></div>
</div>
