@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var entry in ViewData.ModelState.Where(kv => kv.Value is { Errors.Count: > 0 }))
            {
                foreach (var e in entry.Value!.Errors)
                {
                    var text = string.IsNullOrEmpty(e.ErrorMessage) ? L["msg.invalidInput"] : L[e.ErrorMessage];
                    <li>@(string.IsNullOrEmpty(entry.Key) ? text : $"{L.Field(entry.Key)} {text}")</li>
                }
            }
        </ul>
    </div>
}
