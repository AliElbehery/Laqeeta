@model FoundItemFormVm
@{
    ViewData["Title"] = L["items.log"];
    var stations = (IEnumerable<StationDto>)ViewData["Stations"]!;
}
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-body p-4">
    <h1 class="h4 mb-3">@L["items.log"]</h1>
    <partial name="_Errors" />
    <div class="alert alert-info small">@L["items.heldHere"]</div>
    <form method="post" asp-action="Create">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FoundStationId" class="form-label">@L["items.foundStation"]</label>
                <select asp-for="FoundStationId" class="form-select">
                    @foreach (var s in stations) { <option value="@s.StationId" selected="@(s.StationId == Model.FoundStationId)">@s.StationName</option> }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Category" class="form-label">@L["report.category"]</label>
                <select asp-for="Category" class="form-select">
                    @foreach (var c in Enum.GetValues<ItemCategory>()) { <option value="@c" selected="@(c == Model.Category)">@L.Of(c)</option> }
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Color" class="form-label">@L["report.color"]</label><input asp-for="Color" class="form-control" /></div>
            <div class="col-md-6 mb-3">
                <label class="form-label">@L["items.foundAt"]</label>
                <input type="datetime-local" name="FoundAt" class="form-control" value="@Model.FoundAt.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">@L["items.publicDescription"]</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="PrivateIdentifyingDetails" class="form-label">@L["items.privateDetails"] <span class="text-muted small">(@L["common.optional"])</span></label>
            <textarea asp-for="PrivateIdentifyingDetails" class="form-control" rows="2"></textarea>
            <div class="form-text">@L["items.privateHint"]</div>
        </div>
        <button class="btn btn-primary">@L["common.save"]</button>
        <a class="btn btn-link" asp-action="Index">@L["common.cancel"]</a>
    </form>
</div></div></div></div>
